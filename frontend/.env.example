# Local development uses /api through the Vite proxy by default.
# For a deployed frontend, set this to the deployed FastAPI base URL.
VITE_API_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000
# Optional: OAuth client ID from Google Cloud Console. Leave blank to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
# Optional: VAPID public key for push notifications (must match the backend's VAPID_PUBLIC_KEY). Leave blank to hide the "Enable alerts" prompt.
VITE_VAPID_PUBLIC_KEY=
