APP_NAME=PriceYard API
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: OAuth client ID from Google Cloud Console. Leave blank to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
# Comma-separated exact frontend origins; do not use * in production.
CORS_ORIGINS=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Preferred for hosted environments such as Render (HTTPS port 443).
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# Configure these only in your local .env and Render environment variables.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=PriceYard
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Optional: Paystack keys. Leave blank to keep payments disabled (returns 503).
# Use test keys (sk_test_/pk_test_) until Paystack business verification is done.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
